# Public origin of the deployed site (no trailing slash). Used for canonical URLs,
# social share links, robots.txt and the sitemap. Set this in Vercel once the domain is attached.
PUBLIC_SITE_URL=https://fabeventsisrael.com

# Contact form delivery (api/contact.ts). Configure ONE of the two providers.
#
# Option A - Resend (https://resend.com): verify your sending domain, create an API key.
RESEND_API_KEY=
CONTACT_TO=risa.fabevents@gmail.com
CONTACT_FROM=FAB Events Israel <email@fabeventsisrael.com>
#
# Option B - Web3Forms (https://web3forms.com): free access key sent to your inbox.
WEB3FORMS_ACCESS_KEY=
