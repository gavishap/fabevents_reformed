---
/**
 * Page shell: the captured <head>, shared header/footer templates, page content
 * and the page's script tail. Markup is Elementor's rendered output, kept verbatim.
 */
import { loadLayout, fillOrigin, type PageMeta } from '../lib/site';
import { applyActiveState } from '../lib/nav';
import { bundleCapturedStyles } from '../lib/captured-styles';
import NewsTicker from '../components/NewsTicker.astro';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const assetVersion = createHash('sha256').update(readFileSync('public/custom.css')).update(readFileSync('public/scrapbook.js')).digest('hex').slice(0,12);

interface Props {
  meta: PageMeta;
  head: string;
  content: string;
  tail: string;
}

const { meta, head, content, tail } = Astro.props;
const origin = Astro.site ? Astro.site.origin : 'https://fabeventsisrael.com';
const layout = loadLayout();
const fill = (html: string) => fillOrigin(html, origin);
const header = fill(applyActiveState(layout.header, meta));
const showNews = meta.name === 'home' || meta.name === 'contact-us';
const pageStyles = bundleCapturedStyles(meta.name, head);
---

<html lang={meta.htmlLang}>
<head>
{meta.name === 'customized-bar-bat-mitzvot' && (
  <link rel="preload" as="image" href="/images/optimized/bar-bat-mitzvah-celebration-hero-960.webp" media="(max-width: 700px)" />
)}
{meta.name === 'customized-weddings' && (
  <>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="image" type="image/avif" href="/images/optimized/wedding-ceremony-hero-768.avif" media="(max-width: 700px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/images/optimized/wedding-ceremony-hero-1024.webp" media="(min-width: 701px)" fetchpriority="high" />
  </>
)}
<Fragment set:html={fill(pageStyles.head)} />
{meta.name !== 'customized-weddings' && (
  <link rel="preload" href="/fonts/great-vibes.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
)}
{!pageStyles.includesOverrides && <link rel="stylesheet" href={`/custom.css?v=${assetVersion}`} />}
</head>
<body class={`${meta.bodyClass}${showNews ? ' has-news-ticker' : ''}`} data-editor-page={meta.name}>
<Fragment set:html={layout.before} />
<Fragment set:html={header} />
<Fragment set:html={fill(content)} />
<Fragment set:html={fill(layout.footer)} />
<Fragment set:html={fill(tail)} />
{showNews && <NewsTicker />}
{meta.name === 'customized-weddings' ? (
  <script is:inline>
    if (new URLSearchParams(location.search).get('edit') === '1') {
      const editor = document.createElement('script');
      editor.src = '/editor.js';
      document.head.append(editor);
    }
  </script>
) : <script is:inline src="/editor.js"></script>}
<script is:inline defer={meta.name === 'customized-weddings'} src={`/scrapbook.js?v=${assetVersion}`}></script>
</body>
</html>
