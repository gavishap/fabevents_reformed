---
import Site from '../layouts/Site.astro';
import { loadPages, loadPage } from '../lib/site';
import { continuousHome } from '../lib/continuous-home';

export function getStaticPaths() {
  return loadPages()
    .filter((p) => p.type !== '404')
    .map((p) => ({
      params: { slug: p.path === '/' ? undefined : p.path.replace(/^\/|\/$/g, '') },
      props: { name: p.name },
    }));
}

const { name } = Astro.props as { name: string };
const page = loadPage(name);
if (name === 'home') {
  const continuation = continuousHome();
  page.content += continuation.content;
  page.head += continuation.styles;
}
---

<Site meta={page.meta} head={page.head} content={page.content} tail={page.tail} />
